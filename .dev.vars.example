# Copy to .dev.vars (gitignored) and fill in what you have.
#
# Everything here is OPTIONAL. Each one switches a real implementation on in
# place of a stand-in that is named for what it is, and the app runs with none
# of them — that is the point of the stand-ins. What it will not do is pretend:
# every degraded path says so, in the audit log and on the page.
#
# `wrangler dev` reads this file. `next dev` does not, so export these in your
# shell for that; readSetting() checks process.env as well as the bindings.
# Deployed, the secrets go through `wrangler secret put` and never in here.

# --- Cluster C: bot protection -------------------------------------------
# Turnstile > add a widget. Add your hostname to the widget, including
# sidenote.<subdomain>.workers.dev — a widget that does not list the hostname
# rejects every real visitor, which is the most common way this goes wrong.
#
# Without these: UnprotectedBotGate, which lets everything through and writes
# [AUDIT] bot_check_unavailable / no_turnstile_configured on every submission.
#
# Cloudflare's documented test keys, if you only want to see the widget:
#   always passes  1x00000000000000000000AA / 1x0000000000000000000000000000000AA
#   always blocks  2x00000000000000000000AB / 2x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cluster D: presigned uploads ----------------------------------------
# R2 > Manage API tokens > Create. These are the S3-compatible credentials, NOT
# the R2 binding — a binding works inside the Worker and cannot be handed to a
# browser, and presigning is SigV4 against R2's S3 API.
#
# All four or none: a partial set produces a URL that fails at PUT time in the
# browser, where the error is someone else's CORS message rather than ours.
#
# Without these: uploads still work, through the Server Action, capped by
# next.config.ts's bodySizeLimit.
R2_S3_ACCESS_KEY_ID=
R2_S3_SECRET_ACCESS_KEY=
R2_S3_ACCOUNT_ID=
R2_S3_BUCKET=sidenote-documents

# --- Cluster E: AI Gateway -----------------------------------------------
# AI > AI Gateway > create a gateway, then put its name here. This is where
# CLAUDE.md's last architecture row lives — "caching, logging, spend cap on
# every model call" — and every embedding call routes through it when set.
#
# Without it: model calls go direct, uncached and uncapped.
#
# NOTE THE PREFIX. This used to read `AI_GATEWAY_ID`, which nothing in the
# codebase reads — `ai.ts` looks up `SIDENOTE_AI_GATEWAY_ID`. Anyone who
# followed this file got a gateway that was configured and never used, with no
# error to say so.
SIDENOTE_AI_GATEWAY_ID=

# --- REQUIRED IN PRODUCTION ------------------------------------------------
# Everything above is optional. This one is not, and it is the only variable
# here whose absence is fatal rather than degrading.
#
# `sessionSecrets()` THROWS when NODE_ENV is production and this is unset,
# rather than signing with the key printed in auth.ts — anyone who has read
# this repository could otherwise mint a reviewer session. Correct, and easy to
# be surprised by: `next dev` runs with NODE_ENV=development and falls back to
# that default happily, while `wrangler dev` serves an OpenNext PRODUCTION
# build, so the guard fires there and every reviewer route returns 500. Found
# exactly that way, on the first run against workerd.
#
# Any long random string. Deployed it goes through `wrangler secret put`.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIDENOTE_SESSION_SECRET=

# Only when rotating: the outgoing key, so sessions signed under it still
# verify until they expire. See the rotation drill in SETUP.md.
SIDENOTE_SESSION_SECRET_PREVIOUS=

# --- Cluster E: the AI Worker ----------------------------------------------
# Shared secret between the app and `worker-ai`. The SAME value must be in
# worker-ai/.dev.vars, or the service binding returns 401 and the app falls
# back to running the RAG path in-process — which works, and is slower and
# silent apart from one audit line.
#
# Without it: the same in-process fallback, announced as
# [AUDIT] assess_service / binding_present_but_no_shared_secret.
SIDENOTE_ASSESS_SECRET=

# --- Opt in to real Vectorize ----------------------------------------------
# The `vectorize` block in wrangler.jsonc does NOT switch this on: nothing
# reads `env.VECTORIZE`, because vectorize-store.ts talks to the REST API so
# the same code path works under `next dev`. THIS is the switch.
#
# Without it: the local file-backed index, brute-force cosine over every
# vector, which says so on the screen and in the audit line.
SIDENOTE_VECTORIZE_INDEX=
