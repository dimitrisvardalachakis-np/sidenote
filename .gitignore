# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data store (Cluster A only; Cluster D replaces this with D1/R2)
/.data

# cloudflare workers (Cluster C)
# .open-next is the generated Worker bundle; .wrangler is the local workerd
# state directory. Both are build output.
/.open-next
/.wrangler
# Local secrets for `wrangler dev`. TURNSTILE_SECRET_KEY lives here in
# development and in `wrangler secret put` everywhere else. Never committed.
.dev.vars
.dev.vars.*
