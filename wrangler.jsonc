{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidenote",
  // NOT .open-next/worker.js. That file is regenerated by every build and can
  // only export a fetch handler; worker/index.ts imports it, re-exports it
  // unchanged, and adds the Durable Object class beside it. See worker/index.ts.
  "main": "worker/index.ts",

  // workerd 1.20260820.1 ships with this toolchain, so this is the newest date
  // it actually understands. A date in the future is silently ignored, which
  // means you get older runtime behaviour than the file claims.
  "compatibility_date": "2026-08-20",

  // Required by the adapter: Next's server code reaches for node:async_hooks,
  // node:buffer and friends, and without this flag those imports fail at
  // bundle time rather than at runtime, which is at least honest but not
  // useful. It does NOT make node:fs work in any way that matters — see
  // src/lib/store/runtime.ts.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // ---------------------------------------------------------------- Cluster D

  // Cases, reactions, drugs, assessments, documents, chunks, audit.
  // `database_id` is a placeholder until `wrangler d1 create sidenote` issues a
  // real one — local dev ignores it entirely and uses a SQLite file under
  // .wrangler, which is why the whole of Cluster D can be built and tested
  // without a Cloudflare account.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sidenote",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],

  // The uploaded bytes. Keys are `company/<uuid>.pdf` or `public/<uuid>.pdf`;
  // the prefix is the confidentiality namespace and is never mixed.
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "sidenote-documents"
    }
  ],

  // REBUILDABLE ONLY. CLAUDE.md is explicit about that, and it is a real
  // constraint rather than a note: everything in here must be reconstructible
  // from D1 and R2, because KV is eventually consistent and a cache that holds
  // the only copy of something is not a cache.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],

  // One instance per case, addressed by `idFromName(caseId)`. The claim, the
  // ruling and the 15-day alarm live together because they are the three facts
  // that must never be observed in two versions at once.
  "durable_objects": {
    "bindings": [
      {
        "name": "CASE_COORDINATOR",
        "class_name": "CaseCoordinator"
      },
      // One instance for the whole application. Fixes the count-then-add race
      // in reference generation that has been written down in the code since
      // Cluster A step 5 and never fixable without this.
      {
        "name": "REFERENCE_MINTER",
        "class_name": "ReferenceMinter"
      }
    ]
  },

  // SQLite-backed. Required for new classes, and the storage API this class
  // uses is the same either way.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CaseCoordinator", "ReferenceMinter"]
    }
  ],

  // CLAUDE.md's architecture row: "Public report form protection | Turnstile +
  // rate-limit binding". This is the rate-limit half.
  //
  // READ THE PERIOD BEFORE CHANGING THE LIMIT. Cloudflare's rate-limit binding
  // accepts a period of 10 or 60 seconds and nothing else, so the 600-second
  // policies these replace are NOT expressible here. What the binding enforces
  // is the burst; the sustained ceiling needs counter state that outlives a
  // single window, which means a Durable Object.
  //
  // Cluster D has since bound two of those, so this is now a deliberate gap
  // rather than a blocked one: the burst limit is what actually stops abuse,
  // and a third DO to enforce a ten-minute ceiling is cost nobody has asked
  // for. src/lib/protection/rate-limit.ts says the same thing next to the code.
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "CONVERSE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ]

  // TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY are deliberately NOT declared
  // here.
  //
  // A var written into this file gets a LITERAL type from `wrangler types`:
  // declaring `"TURNSTILE_SITE_KEY": ""` types the binding as `""`, and every
  // "is it configured?" test against it becomes a comparison the compiler has
  // already decided. Both keys are therefore declared as optional strings in
  // src/lib/platform/env.ts, and supplied per environment:
  //
  //   locally     .dev.vars           (gitignored)
  //   deployed    site key   -> a plain var, it is public and ships in markup
  //               secret key -> `wrangler secret put TURNSTILE_SECRET_KEY`
  //
  // Absent means "no Turnstile configured", which the bot gate reports loudly
  // rather than mistaking for protection.
}
