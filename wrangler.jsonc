{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidenote",
  "main": ".open-next/worker.js",

  // workerd 1.20260820.1 ships with this toolchain, so this is the newest date
  // it actually understands. A date in the future is silently ignored, which
  // means you get older runtime behaviour than the file claims.
  "compatibility_date": "2026-08-20",

  // Required by the adapter: Next's server code reaches for node:async_hooks,
  // node:buffer and friends, and without this flag those imports fail at
  // bundle time rather than at runtime, which is at least honest but not
  // useful. It does NOT make node:fs work in any way that matters — see
  // src/lib/store/runtime.ts.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // CLAUDE.md's architecture row: "Public report form protection | Turnstile +
  // rate-limit binding". This is the rate-limit half.
  //
  // READ THE PERIOD BEFORE CHANGING THE LIMIT. Cloudflare's rate-limit binding
  // accepts a period of 10 or 60 seconds and nothing else, so the 600-second
  // policies these replace are NOT expressible here. What the binding enforces
  // is the burst; the sustained ceiling needs counter state that outlives a
  // single window, which is a Durable Object and therefore Cluster D.
  // src/lib/protection/rate-limit.ts says the same thing next to the code.
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "CONVERSE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ]

  // TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY are deliberately NOT declared
  // here.
  //
  // A var written into this file gets a LITERAL type from `wrangler types`:
  // declaring `"TURNSTILE_SITE_KEY": ""` types the binding as `""`, and every
  // "is it configured?" test against it becomes a comparison the compiler has
  // already decided. Both keys are therefore declared as optional strings in
  // src/lib/platform/env.ts, and supplied per environment:
  //
  //   locally     .dev.vars           (gitignored)
  //   deployed    site key   -> a plain var, it is public and ships in markup
  //               secret key -> `wrangler secret put TURNSTILE_SECRET_KEY`
  //
  // Absent means "no Turnstile configured", which the bot gate reports loudly
  // rather than mistaking for protection.
}
