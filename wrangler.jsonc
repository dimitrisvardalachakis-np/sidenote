{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidenote",
  // NOT .open-next/worker.js. That file is regenerated by every build and can
  // only export a fetch handler; worker/index.ts imports it, re-exports it
  // unchanged, and adds the Durable Object class beside it. See worker/index.ts.
  "main": "worker/index.ts",

  // workerd 1.20260820.1 ships with this toolchain, so this is the newest date
  // it actually understands. A date in the future is silently ignored, which
  // means you get older runtime behaviour than the file claims.
  "compatibility_date": "2026-08-20",

  // Required by the adapter: Next's server code reaches for node:async_hooks,
  // node:buffer and friends, and without this flag those imports fail at
  // bundle time rather than at runtime, which is at least honest but not
  // useful. It does NOT make node:fs work in any way that matters — see
  // src/lib/store/runtime.ts.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // REACHABLE at sidenote.<subdomain>.workers.dev, and that was a decision
  // rather than a default.
  //
  // This was false, for a reason worth keeping in front of whoever changes it
  // next: the default publishes a guessable public hostname for a Worker
  // serving a queue of confidential safety cases, the password in front of
  // that queue is one shared string, and the workers.dev URL stays open after
  // a custom domain is attached — which is when people stop thinking about it.
  //
  // Turned on so the demo has a front door, and the objection above answered
  // rather than ignored: `SIDENOTE_REVIEWER_PASSWORD` is now a secret, so the
  // shared string is no longer the one printed in auth.ts and in this
  // repository. The data behind it remains synthetic and public-source only.
  //
  // The RAG worker stays false. A service binding is private, and a worker
  // that also answers on workers.dev is not — that one has no reason to have
  // a front door at all.
  "workers_dev": true,

  // And ONLY that one door. With workers.dev on, Cloudflare enables Preview
  // URLs by default — a separate public hostname per VERSION, each serving the
  // same queue, none of them mentioned anywhere. One front door somebody chose
  // is the decision above; a new one per deploy that nobody chose is the thing
  // that decision was guarding against.
  "preview_urls": false,

  // ---------------------------------------------------------------- Cluster F

  // Both nightly, an hour apart so they never contend for the database.
  // The expressions are matched literally in src/lib/schedule/run.ts — changing
  // one here without changing it there falls through to the "unrecognised"
  // branch, which runs both sweeps and says so rather than doing nothing.
  //
  // UTC. 02:00 is after the day has rolled over everywhere that matters for a
  // deadline counted in days.
  "triggers": {
    "crons": ["0 2 * * *", "0 3 * * *"]
  },

  // See worker/server-only.js. The queue consumer drags most of src/lib into a
  // bundle wrangler builds rather than Next, and without React's "react-server"
  // resolver condition the `server-only` marker throws at Worker startup.
  "alias": {
    "server-only": "./worker/server-only.js"
  },

  // ---------------------------------------------------------------- Cluster D

  // Cases, reactions, drugs, assessments, documents, chunks, audit.
  // `database_id` is a placeholder until `wrangler d1 create sidenote` issues a
  // real one — local dev ignores it entirely and uses a SQLite file under
  // .wrangler, which is why the whole of Cluster D can be built and tested
  // without a Cloudflare account.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sidenote",
      "database_id": "7f90d3f8-ec18-4251-ad20-5be3d659be23",
      "migrations_dir": "drizzle"
    }
  ],

  // The uploaded bytes. Keys are `company/<uuid>.pdf` or `public/<uuid>.pdf`;
  // the prefix is the confidentiality namespace and is never mixed.
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "sidenote-documents"
    }
  ],

  // REBUILDABLE ONLY. CLAUDE.md is explicit about that, and it is a real
  // constraint rather than a note: everything in here must be reconstructible
  // from D1 and R2, because KV is eventually consistent and a cache that holds
  // the only copy of something is not a cache.
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "147b0babfefb43969897059e20c2860f"
    }
  ],

  // One instance per case, addressed by `idFromName(caseId)`. The claim, the
  // ruling and the 15-day alarm live together because they are the three facts
  // that must never be observed in two versions at once.
  "durable_objects": {
    "bindings": [
      {
        "name": "CASE_COORDINATOR",
        "class_name": "CaseCoordinator"
      },
      // One instance for the whole application. Fixes the count-then-add race
      // in reference generation that has been written down in the code since
      // Cluster A step 5 and never fixable without this.
      {
        "name": "REFERENCE_MINTER",
        "class_name": "ReferenceMinter"
      }
    ]
  },

  // SQLite-backed. Required for new classes, and the storage API this class
  // uses is the same either way.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CaseCoordinator", "ReferenceMinter"]
    }
  ],

  // ---------------------------------------------------------------- Cluster E

  // Extract -> chunk -> embed -> dedupe -> assess.
  //
  // Producer and consumer are the same queue: the pipeline chains by enqueuing
  // its own next step, so that chunking and embedding retry independently.
  // Chunking is pure and deterministic; embedding is a model call that can be
  // rate limited. Retrying one because the other failed shows up on a bill.
  "queues": {
    "producers": [
      {
        "binding": "INGEST_QUEUE",
        "queue": "sidenote-ingest"
      }
    ],
    "consumers": [
      {
        "queue": "sidenote-ingest",
        // Small batches: each message can be several model calls, and a large
        // batch is a large amount of work to redo when one message fails.
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // Matches MAX_RETRIES in src/lib/pipeline/messages.ts, which the
        // consumer's audit line quotes. A number that disagrees with the
        // platform's is worse than no number.
        "max_retries": 3,
        // A queue somebody has to look at, not a bin. Messages that can never
        // succeed are acked with an audit line instead of being sent here —
        // filling the DLQ with the hopeless teaches people to ignore it.
        "dead_letter_queue": "sidenote-ingest-dlq"
      }
    ]
  },

  // One index, two namespaces — `company` and `public`. Namespaces rather than
  // two indexes because a namespace is a filter applied inside the index, which
  // is exactly the shape wanted: the same query, run against one corpus or the
  // other, never both. The namespace IS the confidentiality boundary.
  //
  // 768 dimensions is not a preference: it is the width of
  // @cf/baai/bge-base-en-v1.5, and an index created at another width rejects
  // every upsert. Create it with:
  //   wrangler vectorize create sidenote-chunks --dimensions=768 --metric=cosine
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "sidenote-chunks"
    }
  ],

  // Workers AI. Embeddings today; CLAUDE.md's Whisper and Llama rows are not
  // built, and no code pretends they are.
  // ---------------------------------------------------------------------
  // The RAG path, in a Worker of its own.
  //
  // Everything that spends money or takes time — retrieval, fusion, and the
  // two generations per case — runs in `sidenote-assess`, which has its own
  // AI and Vectorize bindings and no public URL. This app holds none of the
  // credentials it uses, and reaches it only through this binding.
  //
  // The app still works without it. `getAssessService()` falls back to running
  // the same code in-process when the binding is absent, which is what `next
  // dev` and the test suite do, and a remote failure falls back too rather
  // than breaking the case screen.
  // ---------------------------------------------------------------------
  "services": [
    {
      "binding": "ASSESS",
      "service": "sidenote-assess"
      // NO "entrypoint". It names a `WorkerEntrypoint` subclass exported from
      // the target Worker — it is not the string "default", and setting it to
      // that stops the runtime starting at all:
      //
      //   binding "ASSESS" refers to service "sidenote-assess" with a named
      //   entrypoint "default", but it has no such named entrypoint
      //
      // Omitting it means the default export's fetch handler, which is what
      // worker-ai/index.ts provides. Nothing catches this before workerd does.
    }
  ],

  "ai": {
    "binding": "AI"
  },

  // CLAUDE.md's architecture row: "Public report form protection | Turnstile +
  // rate-limit binding". This is the rate-limit half.
  //
  // READ THE PERIOD BEFORE CHANGING THE LIMIT. Cloudflare's rate-limit binding
  // accepts a period of 10 or 60 seconds and nothing else, so the 600-second
  // policies these replace are NOT expressible here. What the binding enforces
  // is the burst; the sustained ceiling needs counter state that outlives a
  // single window, which means a Durable Object.
  //
  // Cluster D has since bound two of those, so this is now a deliberate gap
  // rather than a blocked one: the burst limit is what actually stops abuse,
  // and a third DO to enforce a ten-minute ceiling is cost nobody has asked
  // for. src/lib/protection/rate-limit.ts says the same thing next to the code.
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "CONVERSE_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    // The public lookup gets its OWN ceiling because it costs its own money.
    // /report/search is anonymous and answering one runs an openFDA fetch, a
    // chunking pass, an embedding call and up to four inferences. The chat
    // costs at most two. Sharing the chat's 20/minute meant the most expensive
    // anonymous path in the app was governed by a number chosen for the
    // cheapest. Six a minute is more than any person types.
    {
      "name": "SEARCH_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 6, "period": 60 }
    }
  ]

  // TURNSTILE_SITE_KEY and TURNSTILE_SECRET_KEY are deliberately NOT declared
  // here.
  //
  // A var written into this file gets a LITERAL type from `wrangler types`:
  // declaring `"TURNSTILE_SITE_KEY": ""` types the binding as `""`, and every
  // "is it configured?" test against it becomes a comparison the compiler has
  // already decided. Both keys are therefore declared as optional strings in
  // src/lib/platform/env.ts, and supplied per environment:
  //
  //   locally     .dev.vars           (gitignored)
  //   deployed    site key   -> a plain var, it is public and ships in markup
  //               secret key -> `wrangler secret put TURNSTILE_SECRET_KEY`
  //
  // Absent means "no Turnstile configured", which the bot gate reports loudly
  // rather than mistaking for protection.
}
